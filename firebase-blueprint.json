{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Student profiles, study stats, preferences, and gamification points",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "classLevel": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "profileImage": { "type": "string" },
        "points": { "type": "number" },
        "streak": { "type": "number" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "preferences": { "type": "object" },
        "role": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "users/{userId}/bookmarks": {
      "title": "User Bookmarks",
      "description": "Saved educational resources for offline study and quick access",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "classLevel": { "type": "string" }
      },
      "required": ["resourceId"]
    },
    "users/{userId}/quizAttempts": {
      "title": "User Quiz Attempts",
      "description": "History of UNEB quiz self-assessments, scores, and grades",
      "type": "object",
      "properties": {
        "quizId": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "unebGrade": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "answers": { "type": "array" },
        "duration": { "type": "number" }
      },
      "required": ["subject", "score", "percentage", "completedAt"]
    },
    "users/{userId}/recentlyViewed": {
      "title": "Recently Viewed Resources",
      "description": "Recent study resources opened by the student",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["resourceId", "viewedAt"]
    },
    "users/{userId}/progress": {
      "title": "Learning Progress Events",
      "description": "Persistent learning activity tracking",
      "type": "object",
      "properties": {
        "eventType": { "type": "string" },
        "resourceId": { "type": "string" },
        "subject": { "type": "string" },
        "pointsEarned": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["eventType", "timestamp"]
    },
    "resources": {
      "title": "Educational Resources",
      "description": "Curriculum notes, UNEB past papers, textbooks, and revision guides",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "classLevel": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "resourceType": { "type": "string" },
        "author": { "type": "string" },
        "source": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileSize": { "type": "string" },
        "format": { "type": "string" },
        "pages": { "type": "number" },
        "objectives": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "downloadCount": { "type": "number" },
        "viewCount": { "type": "number" },
        "popularity": { "type": "number" },
        "isFree": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" }
      },
      "required": ["title", "subject", "classLevel", "resourceType", "isFree"]
    },
    "quizzes": {
      "title": "UNEB Quizzes",
      "description": "Interactive multiple choice question sets for revision",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "classLevel": { "type": "string" },
        "topic": { "type": "string" },
        "difficulty": { "type": "string" },
        "questions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "questions"]
    },
    "reports": {
      "title": "Resource Reports",
      "description": "Student feedback on broken links, factual corrections, or quality issues",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string" },
        "resourceTitle": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "reason": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["resourceId", "reason", "createdAt"]
    }
  }
}
